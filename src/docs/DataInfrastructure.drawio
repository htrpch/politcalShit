                </mxCell>
                <mxCell id="2vjpSDWTN2c6FkAyptV9-11" value="&lt;div&gt;Check the required fields (&quot;rig_name&quot;, &quot;system&quot;, &quot;variable&quot;), filters only messages that have &quot;tonne_mile&quot; and adds to the Tonmile SQS queue.&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="2vjpSDWTN2c6FkAyptV9-1" vertex="1">
                    <mxGeometry x="-1719.25" y="153.25" width="449" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="2vjpSDWTN2c6FkAyptV9-12" value="Fetch the data from the Tonmile SQS Queue and upserts to dynamo.&lt;br&gt;This is done because there are entries that doesn't have all the &lt;i&gt;tags &lt;/i&gt;that are needed to do the tonmile calculation.&lt;br&gt;Adding to a cache layer (dynamodb) makes it easier to collect all the information neede for the calculation." style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="2vjpSDWTN2c6FkAyptV9-1" vertex="1">
                    <mxGeometry x="-1721.5" y="271.75" width="450" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="2vjpSDWTN2c6FkAyptV9-13" value="There is a step function for each rig, which improves observability and increase the resilience of the system. The chosen period for calculating the tonmile is 30 minutes." style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="2vjpSDWTN2c6FkAyptV9-1" vertex="1">
                    <mxGeometry x="-1721.5" y="389.75" width="450" height="117" as="geometry"/>
                </mxCell>
                <mxCell id="2vjpSDWTN2c6FkAyptV9-14" value="&lt;span&gt;The tonmile calculation lambda function persists the calculation and raw data to the application database. It also updates the active_cable entry with the tonmile information.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="2vjpSDWTN2c6FkAyptV9-1" vertex="1">
